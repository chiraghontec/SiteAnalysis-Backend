# Multi Tool Agent Configuration Template
# Copy this file to .env and update with your actual credentials

# Google AI API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Neon Database Configuration (Cloud PostgreSQL)
# Sign up at: https://neon.tech (free tier provides 0.5GB storage)
# Create a project and copy connection details from your dashboard
DB_HOST=your_neon_host_here.neon.tech
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password_here
DB_PORT=5432

# Setup Instructions:
# 1. Visit https://neon.tech and create a free account
# 2. Create a new project (use default 'neondb' database)
# 3. Copy connection details from the Neon dashboard
# 4. Replace the placeholder values above with your actual credentials
# 5. Run the database schema SQL from the README in your Neon SQL editor
# 6. Install dependencies: pip install psycopg2-binary python-dotenv
# 7. Test connection: python -c "from database_manager import DatabaseManager; db = DatabaseManager(); print('✅ Ready!' if db.test_connection() else '❌ Check config')"

# Database Features Available:
# - Smart API response caching with spatial indexing
# - User interaction analytics and behavior tracking  
# - PostGIS spatial queries for location-based intelligence
# - Performance monitoring and optimization insights
# - Automatic cache cleanup and maintenance
# - Serverless auto-pause/resume with connection retry logic
