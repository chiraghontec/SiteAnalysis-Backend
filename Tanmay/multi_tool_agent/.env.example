# Google AI Configuration
GOOGLE_API_KEY=your_google_api_key_here

# Neon Database Configuration (Cloud PostgreSQL)
DB_HOST=your_neon_host_here
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password_here
DB_PORT=5432

# Instructions:
# 1. Copy this file to .env in the same directory
# 2. Replace 'your_google_api_key_here' with your actual Google API key
# 3. Get your API key from: https://aistudio.google.com/app/apikey
# 4. Set up neonDB
# 5. Replace the DB_* values with your actual Neon connection details
# 6. Keep DB_NAME as 'neondb' and DB_USER as 'neondb_owner' (Neon defaults)
